rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDocumentPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminDocumentPath())
        && get(adminDocumentPath()).data.active == true;
    }

    function validText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validOptionalText(value, max) {
      return value is string && value.size() <= max;
    }

    function validOrder(value) {
      return value is int && value >= 0 && value <= 9999;
    }

    function validCount(value) {
      return value is int && value >= 0 && value <= 9999;
    }

    function validPercent(value) {
      return value is int && value >= 0 && value <= 100;
    }

    function validZoom(value) {
      return value is int && value >= 100 && value <= 220;
    }

    function validHttpsUrlOrEmpty(value) {
      return value is string
        && value.size() <= 2048
        && (value == '' || value.matches('^https://[^\\s<>"`]+$'));
    }

    function validVideoUrl(value) {
      return value is string
        && value.size() >= 12
        && value.size() <= 2048
        && value.matches('^https://[^\\s<>"`]+$');
    }

    function validCourseData() {
      return request.resource.data.keys().hasOnly([
          'title', 'short', 'description', 'imageUrl', 'imagePositionX', 'imagePositionY', 'imageZoom', 'order', 'videoCount'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'short', 'description', 'imageUrl', 'imagePositionX', 'imagePositionY', 'imageZoom', 'order', 'videoCount'
        ])
        && validText(request.resource.data.title, 1, 120)
        && validOptionalText(request.resource.data.short, 220)
        && validOptionalText(request.resource.data.description, 1200)
        && validHttpsUrlOrEmpty(request.resource.data.imageUrl)
        && validPercent(request.resource.data.imagePositionX)
        && validPercent(request.resource.data.imagePositionY)
        && validZoom(request.resource.data.imageZoom)
        && validOrder(request.resource.data.order)
        && validCount(request.resource.data.videoCount);
    }

    // ملاحظة: videoUrl هنا بقى جزء من مستند الدرس نفسه (الطريقة البسيطة) —
    // مفيش مجموعة videoSecrets منفصلة. أي حساب مسجّل دخول يقدر يقرأ الرابط.
    function validLessonData() {
      return request.resource.data.keys().hasOnly([
          'title', 'instructor', 'duration', 'order', 'imageUrl', 'imagePositionX', 'imagePositionY', 'imageZoom', 'videoUrl'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'instructor', 'duration', 'order', 'imageUrl', 'imagePositionX', 'imagePositionY', 'imageZoom', 'videoUrl'
        ])
        && validText(request.resource.data.title, 1, 120)
        && validOptionalText(request.resource.data.instructor, 90)
        && validOptionalText(request.resource.data.duration, 40)
        && validOrder(request.resource.data.order)
        && validHttpsUrlOrEmpty(request.resource.data.imageUrl)
        && validPercent(request.resource.data.imagePositionX)
        && validPercent(request.resource.data.imagePositionY)
        && validZoom(request.resource.data.imageZoom)
        && validVideoUrl(request.resource.data.videoUrl);
    }

    function validAdminData() {
      return request.resource.data.keys().hasOnly(['active', 'email'])
        && request.resource.data.keys().hasAll(['active'])
        && request.resource.data.active is bool
        && (!('email' in request.resource.data) || validOptionalText(request.resource.data.email, 254));
    }

    function validStudentProfile() {
      return request.resource.data.keys().hasOnly(['email', 'lastLoginAt', 'online', 'lastSeen'])
        && request.resource.data.keys().hasAll(['email'])
        && validOptionalText(request.resource.data.email, 254)
        && (!('online' in request.resource.data) || request.resource.data.online is bool)
        && (!('lastLoginAt' in request.resource.data) || request.resource.data.lastLoginAt is timestamp)
        && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen is timestamp);
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly([
          'studentUid', 'studentEmail', 'courseId', 'courseTitle', 'completedLessonIds',
          'completedCount', 'totalLessons', 'percent', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'studentUid', 'courseId', 'courseTitle', 'completedLessonIds',
          'completedCount', 'totalLessons', 'percent', 'updatedAt'
        ])
        && request.resource.data.studentUid == request.auth.uid
        && validText(request.resource.data.courseId, 1, 160)
        && validText(request.resource.data.courseTitle, 1, 120)
        && request.resource.data.completedLessonIds is list
        && request.resource.data.completedCount is int
        && request.resource.data.totalLessons is int
        && validPercent(request.resource.data.percent)
        && request.resource.data.completedCount >= 0
        && request.resource.data.totalLessons >= 0
        && request.resource.data.completedCount <= request.resource.data.totalLessons;
    }

    match /admins/{adminUid} {
      allow get: if signedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if false;
      allow create, update: if isAdmin() && validAdminData();
      allow delete: if isAdmin() && request.auth.uid != adminUid;
    }

    match /courses/{courseId} {
      // بيانات الكورس العامة — أي زائر يقدر يشوفها (للعرض قبل تسجيل الدخول)
      allow read: if true;
      allow create, update: if isAdmin() && validCourseData();
      allow delete: if isAdmin();

      match /videos/{videoId} {
        // فيه videoUrl جوه المستند ده — أي حساب مسجّل دخول بس يقدر يقراه
        allow read: if signedIn();
        allow create, update: if isAdmin() && validLessonData();
        allow delete: if isAdmin();
      }
    }

    match /studentProfiles/{studentUid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == studentUid);
      allow create: if (isAdmin() || (signedIn() && request.auth.uid == studentUid))
        && validStudentProfile();
      allow update: if signedIn() && request.auth.uid == studentUid && validStudentProfile();
      allow delete: if isAdmin();
    }

    match /progress/{progressId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.studentUid == request.auth.uid && validProgress();
      allow delete: if isAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
