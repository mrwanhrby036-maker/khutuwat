rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات الكورس (العنوان والوصف) — للعرض للجميع
    // الفيديوهات — للمسجلين فقط
    // الكتابة — للأدمن فقط (غيّر الإيميل لو غيّرته)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "marwanhrby@gmail.com";

      match /videos/{videoId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && request.auth.token.email == "marwanhrby@gmail.com";
      }
    }
  }
}
